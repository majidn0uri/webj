# ─────────────────────────────────────────────────────────────────────────────
# ست‌شاپ — آنچه هرگز نباید وارد مخزن شود
#
# سه دسته‌اند: وابستگی‌ها (بازساختنی)، خروجیِ ساخت (مشتق از کد)، و رازها/داده
# (متغیر در زمان). قانونِ ساده: هرچه را می‌توان از کد بازساخت یا در محیط
# تغییر می‌کند، اینجا بنویس — مخزن فقط «کد و مستند» است.
# ─────────────────────────────────────────────────────────────────────────────
node_modules
dist
out
build
.turbo
.next
coverage
*.log
*.tsbuildinfo
.DS_Store

# محیط و رازها: هیچ کلید/رمزی در تاریخچه نماند
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.token
credentials
.secrets/

# پایگاهِ محلی (داده‌یِ زمانِ توسعه — در سرور جایِ دیگری است)
.data/

# ─────────────────────────────────────────────────────────────────────────────
# رسانه (تصویرِ بارگذاری‌شده از پنل)
#
# این‌ها «داده»اند نه «کد»: با هر بارگذاری عوض می‌شوند، بزرگ می‌شوند، و در
# استقرار روی یک دیسکِ جدا (MEDIA_DIR) می‌نشینند. رفتنشان به مخزن یعنی هر
# مخزن به اندازه‌یِ همه‌یِ تصویرهایِ فروشگاه سنگین شود.
# ─────────────────────────────────────────────────────────────────────────────
var/media/
