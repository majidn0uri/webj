[Unit]
Description=هر ۳۰ دقیقه: صدورِ صورتحساب‌هایِ جامانده و آغازِ گارانتیِ فروش‌هایِ تازه
Documentation=file:/srv/setshop/deploy/README.md

[Timer]
OnBootSec=3min
# مهلتِ قانونیِ ارسالِ صورتحساب کوتاه است، اما جریمه‌یِ آن برایِ هر فروش
# جداگانه است؛ بنابراین از یک سو نباید ساعت‌ها عقب بیفتد و از سویِ دیگر
# نیازی به اجرایِ هر دقیقه نیست. نیم‌ساعت تعادلی است میانِ تازگی و بارِ پایگاه.
OnUnitActiveSec=30min
RandomizedDelaySec=120
# اگر ماشین هنگامِ موعد خاموش بود، نخستین فرصت جبران می‌شود: گارانتی‌ای که از
# تاریخِ پرداخت آغاز می‌شود، با تأخیرِ کارگر کوتاه نمی‌شود (مدت از «پرداخت»
# حساب می‌شود، نه از «امروز»).
Persistent=true
Unit=setshop-postsale.service

[Install]
WantedBy=timers.target
