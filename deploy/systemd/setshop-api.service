[Unit]
# «۵ تلاش در هر ۵ دقیقه»: خرابیِ گذرا دوباره بالا می‌آید، اما چرخه‌یِ
# بی‌پایانِ «بالا آمدن و افتادن» متوقف می‌شود. این دو کلید باید در همین
# بخش باشند؛ در [Service] نادیده گرفته می‌شوند (systemd-analyze verify).
StartLimitBurst=5
StartLimitIntervalSec=300
Description=ست‌شاپ — سرویسِ API
Documentation=file:/srv/setshop/deploy/README.md
After=network.target setshop-postgres.service
Requires=setshop-postgres.service

[Service]
Type=simple
User=setshop
Group=setshop
WorkingDirectory=/srv/setshop
EnvironmentFile=/etc/setshop/env
Environment=NODE_ENV=production
# حافظه‌یِ هیپ محدود شود تا مصرفِ بی‌رویه به‌جایِ قفل کردنِ کلِ سیستم،
# با یک خروجِ کنترل‌شده همراه باشد (systemd دوباره راه‌اندازی‌اش می‌کند).
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/npm run start:api
Restart=always
RestartSec=3

# --- سخت‌سازی (Hardening) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/setshop
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:/var/log/setshop/api.log
StandardError=append:/var/log/setshop/api.log

[Install]
WantedBy=multi-user.target
