[Unit]
Description=ست‌شاپ — یادآوری سررسید چک‌ها (هر روز صبح)
Documentation=file:/srv/setshop/deploy/README.md
After=network.target setshop-postgres.service
Requires=setshop-postgres.service

[Service]
Type=oneshot
User=setshop
Group=setshop
WorkingDirectory=/srv/setshop
EnvironmentFile=/etc/setshop/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npx tsx scripts/check-due-reminder.ts
Restart=on-failure
RestartSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=setshop-check-due

[Install]
WantedBy=multi-user.target