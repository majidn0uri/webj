# =====================================================================
# ست‌شاپ — نمونه‌ی تنظیماتِ محیطی (تولید)
# ---------------------------------------------------------------------
# این فایل را کپی کنید:   cp deploy/env.example /etc/setshop/env
# سپس مقادیرِ «حتماً تغییر دهید» را پر کنید و دسترسی را محدود کنید:
#   chmod 600 /etc/setshop/env && chown setshop:setshop /etc/setshop/env
#
# هیچ رازی در مخزنِ کد نباید باشد. این فایل فقط «قالب» است.
# =====================================================================

# --- محیط -----------------------------------------------------------
NODE_ENV=production

# --- شبکه -----------------------------------------------------------
# در تولید API باید فقط روی لوکال‌هاست گوش بدهد؛ بیرون فقط از راهِ nginx می‌رسد.
# (در توسعه/پیش‌نمایش پیش‌فرضِ کد 0.0.0.0 است تا از مرورگر و موبایل دیده شود؛
#  این سطر آن را صریحاً برای تولید قفل می‌کند.)
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=3100

# --- نشانیِ مشتری (سقف‌ها و لاگ به همین نشانی گره خورده‌اند) --------------
# فهرستِ جدا‌شده با ویرگول: هر IP یا شبکه‌ای که **مجاز** است بگوید «مشتریِ
# من این است». تنها اگر سوکتِ درخواست از یکی از این‌ها آمده باشد، سرآیندهایِ
# `X-Real-IP` و `X-Forwarded-For` خوانده می‌شوند؛ وگرنه API سرآیندها را دور
# می‌ریزد و همان نشانیِ سوکت را باور می‌کند (fail closed).
# چرا لازم است: با `trustProxy: true` هر بازدیدکننده می‌توانست با یک سرآیند
# جعلی، سقفِ «۱۰ سفارش در ساعت» یا «۱۰ تلاشِ ورود در ۱۰ دقیقه» را دور بزند.
# nginx روی همین ماشین = 127.0.0.1 (پیش‌فرضِ تولید همین است). اگر API را پشتِ
# یک CDN/پروکسیِ جدا می‌برید، نشانیِ همان‌ها را اضافه کنید.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# لایه‌یِ وب (Nest نیست، Next است) نشانیِ مشتری را با سرآیندِ درونی
# `x-set-client-ip` به API می‌رساند تا سقف‌ها «به ازایِ هر خریدار» بشمارند،
# نه «به ازایِ کلِ فروشگاه». بی‌کلیدِ درونی این سرآیند بی‌اعتبار است؛ این
# کلید را فقط برایِ خاموش‌کردنِ رفتار بگذارید (بی‌دلیل نیاید).
TRUST_WEB_CLIENT_IP=true
# میانجی‌هایِ وب (جستجو، تصمیمِ پرداخت) `x-forwarded-for` را **پیش‌فرض
# نمی‌خوانند**، چون نخستینِ مقدارش را خودِ کلاینت می‌نویسد. اگر nginx شما
# فقط XFF می‌فرستد (`$proxy_add_x_forwarded_for`)، این را روی 1 بگذارید تا
# زنجیره از **آخر** خوانده شود — راهِ درست همان `X-Real-IP $remote_addr` است
# که در `deploy/nginx/setshop.conf` از پیش نشسته است.
TRUST_XFF=

# --- پایگاه‌داده (PostgreSQL واقعی — الزامی در تولید) ------------------
# چرا پستگرسِ جدا؟ چون پایگاه‌داده‌ی درون‌فرآیندی (PGlite) حافظه را در
# کارتِ API مصرف می‌کند و هنگامِ فشار، کلِ حلقه‌ی رویداد قفل می‌شود.
# اندازه‌گیری‌شده روی یک دستگاهِ ۲ گیگابایتی: ۴۰۴ مگابایت → ۱۸۵ مگابایت.
# گزینه‌ی ۱ (توصیه‌شده، امن‌تر): سوکتِ یونیکس — دسترسی با مجوزِ فایل کنترل
# می‌شود، نه با رمز، و پستگرس اصلاً روی شبکه گوش نمی‌دهد.
DB_URL=postgres://setshop@/setshop?host=/run/setshop&port=5433

# گزینه‌ی ۲: تی‌سی‌پیِ لوکال با رمز (اگر بعداً اتصالِ راه‌دور لازم شد)
# DB_URL=postgres://setshop:حتماً-تغییر-دهید@127.0.0.1:5433/setshop

# --- امنیت -----------------------------------------------------------
# حداقل ۳۲ نویسه‌ی تصادفی:  openssl rand -base64 48
#
# در محیطِ تولید، نبودِ این کلید یا همان مقدارِ پیش‌فرض یعنی **برنامه بالا
# نمی‌آید** (خطا در همان آغاز، نه در میانه‌یِ کار). چرا این‌قدر سخت؟ چون این
# کلید، مُهرِ «من مدیرم» است: با کلیدِ شناخته‌شده، هر کسی می‌تواند برایِ خودش
# توکنِ مدیر امضا کند و هیچ لاگی جلویِ او را نمی‌گیرد — و بعد از ورود، ردی از
# «چگونه وارد شد» نمی‌ماند.
# `deploy/install.sh` خودش یک کلیدِ تصادفی می‌سازد؛ دستی تنظیم نکنید مگر
# کلیدِ معتبری از جایِ دیگری دارید (و در آن صورت در پوشه‌یِ رمز نگهش دارید).
JWT_SECRET=حتماً-تغییر-دهید-حداقل-۳۲-نویسه

# مبدأهایِ مجاز برایِ درخواستِ میان‌دامنه‌ای، با ویرگول جدا.
# خالی = فقط همان APP_URL (که برایِ تک‌دامنه درست است). پر کردنش با * یا
# فهرستِ بلند یعنی هر سایتی می‌تواند با کوکیِ نشستِ کاربرِ واردشده از این
# API بخواند؛ فقط زمانی لازم است که پنل رویِ دامنه‌یِ دیگری نشسته باشد.
CORS_ORIGINS=

# --- مالیات ----------------------------------------------------------
# نرخِ ارزش افزوده بر حسبِ «واحدِ درصد» (basis point): ۹۰۰ یعنی ۹٪
#
# این فقط پیش‌فرض است. اگر مدیر در پنل «نرخِ ارزش‌افزوده» را تنظیم کند، همان
# عدد مقدم است — و درست هم هست، چون نرخِ مالیات در طولِ سال عوض می‌شود و
# کسی که باید آن را بداند، فروشنده است نه پرونده‌یِ تنظیماتِ سرور. سبدِ خرید،
# ثبتِ سفارش، فروشِ حضوری و برگه‌یِ سبد همگی از همین یک منبع می‌خوانند؛ پیش‌تر
# عددِ ۹٪ در سه جایِ کد چسبیده بود و تنظیمِ پنل رویِ هیچ‌کدام اثر نداشت.
VAT_RATE_BP=900

# ─────────────────────────────────────────────────────────────────────────────
# رسانه (تصویرِ کالا)
# پوشه‌ای که تصویرهایِ بارگذاری‌شده در آن می‌نشینند. باید نوشتنی باشد برای
# کاربری که API را اجرا می‌کند، و در پشتیبان‌گیری همراهِ پایگاه بیاید.
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_DIR=/var/lib/setshop/media

# --- کلیدِ اصلیِ گاوصندوق (الزامی برایِ گواهیِ مؤدیان) -------------------
# گواهی و کلیدِ خصوصی از **پنل** بارگذاری می‌شوند و در پایگاه، رمزنگاری‌شده
# می‌نشینند؛ کلیدی که با آن رمز می‌کنیم (SET_MASTER_KEY) باید بیرون از پایگاه
# باشد — وگرنه هر کسی که به یک نسخه‌یِ پشتیبان برسد، می‌تواند به نامِ فروشگاه
# صورتحساب امضا کند.
#
# ساخت:   openssl rand -base64 32
#
# دو هشدارِ جدی:
#   • این کلید را در مخزنِ کد، در ایمیل یا در پشتیبانِ پایگاه نگذارید؛
#   • اگر گم شود، گواهی‌هایِ درونِ پایگاه دیگر قابلِ گشودن نیستند و باید
#     دوباره بارگذاری شوند (گم‌شدنِ داده نیست — فقط بازگشت به نقطه‌یِ صفر).
SET_MASTER_KEY=

# --- سامانه‌یِ مؤدیان (صورتحسابِ الکترونیکی) ----------------------------
# در حالتِ آزمایشی هیچ اتصالی به سازمان برقرار نمی‌شود: بسته‌ها ساخته،
# بررسی و ذخیره می‌شوند تا خطاهایِ داده‌ای پیش از روزِ رسمی دیده شود.
# برایِ ارسالِ واقعی: production + تنظیمات در پنل (مالیات)
#
# نکته: مسیرهایِ کلید در محیط دیگر **لازم نیستند** — گواهی را در پنل
# بارگذاری کنید. این خط‌ها فقط برایِ نصب‌هایِ قدیمی‌تر مانده‌اند و در صورتِ
# نبودن، سامانه از گاوصندوق می‌خواند.
MOADIAN_MODE=sandbox              # sandbox | production
MOADIAN_CLIENT_ID=
MOADIAN_FISCAL_ID=                # شناسه‌یِ یکتایِ حافظه‌یِ مالیاتی
# کلیدها بیرون از پوشه‌یِ پروژه؛ مالک: setshop، دسترسی: ۶۰۰
MOADIAN_PRIVATE_KEY_PATH=/etc/setshop/keys/private.pem
MOADIAN_CERTIFICATE_PATH=/etc/setshop/keys/certificate.crt
MOADIAN_PUBLIC_KEY_PATH=/etc/setshop/keys/tax-public.pem

# --- الزامِ «فقط ایران» (بخش AA) --------------------------------------
# true: هر درخواست به دامنه‌ی خارجی خطا می‌گیرد (سایت باید بدونِ اینترنتِ
# بین‌الملل هم کامل بالا بیاید).
STRICT_IRAN_ONLY=true

# --- درگاهِ پرداختِ ایرانی ---------------------------------------------
# نشانیِ عمومیِ فروشگاه: نشانیِ بازگشت از درگاه از روی آن ساخته می‌شود
APP_URL=https://forushgah.example.com
# کدام درگاه پیش‌فرض است: sandbox | zarinpal | idpay
PAYMENT_GATEWAY=zarinpal
# در تولید درگاهِ آزمایشی خاموش است مگر اینکه صریحاً اجازه بدهید (دموی اختصاصی)
PAYMENT_ALLOW_SANDBOX=0

# زرین‌پال (REST نسخه‌ی ۴) — مرچنت‌کد را از پنلِ زرین‌پال بگیرید
ZARINPAL_MERCHANT_ID=
ZARINPAL_CURRENCY=IRR        # IRR = ریال (پیش‌فرض) | IRT = تومان
ZARINPAL_SANDBOX=0           # برای تست با https://sandbox.zarinpal.com مقدار ۱

# آی‌دی‌پی (نسخه‌ی ۱.۱)
IDPAY_API_KEY=
IDPAY_SANDBOX=1

# نکته‌ی مهم: نشانیِ بازگشتِ ثبت‌شده در پنلِ درگاه باید دقیقاً برابر باشد با
#   https://forushgah.example.com/pay/callback
# اگر این دو یکی نباشند، درگاه پس از پرداخت مشتری را برنمی‌گرداند.

# --- پیامک (قالب‌هایِ تأییدشده در سامانه‌ی پیامکیِ ایرانی) ---------------
# منبعِ اول، پنل است: «تنظیمات ← پیامک». آنچه اینجا نوشته می‌شود فقط
# پشتیبانِ کارگرِ systemd (و توسعه) است؛ یعنی اگر کلیدی در پنل پر نباشد،
# از محیط خوانده می‌شود. دلیلش ساده است: مدیر نباید برای یک کلید، به
# فایلِ رویِ سرور و یک سرویس‌ریستاره نیاز داشته باشد.
#
# «ارائه‌دهنده» در پنل: none | kavenegar | melipayamak | farazsms
# (نامِ متغیر SMS_PROVIDER است — در مستنداتِ کهنه «SMS_DRIVER» نوشته شده بود
#  و هیچ‌جا خوانده نمی‌شد؛ اصلاح شد تا کپی‌کردنِ این فایل واقعاً کار کند.)
SMS_PROVIDER=none
SMS_API_KEY=                    # کاوه‌نگار/فراز: کلیدِ API — ملی: «کاربری|گذرواژه»
SMS_SENDER=                     # خطِ پیامک؛ برایِ قالب‌هایِ تأییدشده لازم نیست
# روشن/خاموشِ ارسال فقط در پنل است (sms_enabled)؛ کارگر با «خاموش» هیچ
# پیامکی نمی‌فرستد و صف دست‌نخورده می‌ماند.
SMS_MAX_ATTEMPTS=5              # بعد از این تلاش، پیام «ناامیدکننده» می‌شود
SMS_RETRY_MINUTES=10            # فاصله، دو‌برابر می‌شود (۱۰، ۲۰، ۴۰… و حداکثر یک روز)
SMS_TIMEOUT_MS=10000
# نشانیِ سامانه فقط در حالتِ توسعه/آزمایش عوض می‌شود (شبیه‌سازِ محلی):
# SMS_KAVENEGAR_URL=http://127.0.0.1:8099
# SMS_MELI_URL=
# SMS_FARAZ_URL=
# با فرستادنِ صف به نشانیِ لوکال، قاعدهٔ «فقط سرویس ایرانی» جلوی‌تان را می‌گیرد.
# این دو فقط برایِ همین کارند — در نصبِ واقعی پر نکنید:
# SMS_ALLOW_INSECURE=1          # اجازهٔ http (فقط لوکال/شبکهٔ داخلی)
# SMS_EXTRA_HOSTS=127.0.0.1     # افزودنِ میزبان به فهرستِ مجاز
# مهلتِ سکوتِ کارگر برایِ هشدارِ «صف خوابیده است» هم فقط در پنل است
# (تنظیمات ← پیامک ← «مهلتِ سکوتِ کارگرِ صف»، کلیدِ sms_worker_stale_minutes،
#  پیش‌فرض ۷۰ دقیقه). عمداً متغیرِ محیطی ندارد: باید با فاصلهٔ اجرایِ تایمر
#  هم‌راستا شود و مدیرِ فروشگاه خودش بهتر از فایلِ env آن فاصله را می‌داند.
# SMS_DRY_RUN=1                 # صف را بخوان، اما به سامانه نفرست (آماده‌سازی)
# SMS_BATCH=20                  # در هر دور، چند پیامک (کارگرِ پس از فروش)
# POSTSALE_PURGE_LIMIT=2000     # در هر دور، چند سطرِ کهنه از جدول‌ها برود (نگهداریِ داده)
# POSTSALE_MEDIA_LIMIT=200      # در هر دور، چند فایلِ بی‌صاحب از دیسک برود
#                               # (پاک‌سازیِ فایل تنها با media_autopurge='true' در پنل اجرا می‌شود؛
#                               #  بی‌آن فقط گزارش می‌شود. ۰ بودنِ media_grace_days یعنی پویش هم نکن.)
# برایِ رفعِ اشکال نیازی به این متغیرها نیست: «تنظیمات ← پیامک ← آزمونِ ارسال»
# یک پیامک به شمارهٔ خودتان می‌فرستد، پاسخِ خامِ سامانه را همان‌جا نشان می‌دهد و
# چک‌لیستِ «چرا پیامکی نمی‌رود؟» را می‌آورد؛ اگر خانه‌ای را پر کردید، دکمهٔ
# «بازگرداندنِ پیام‌هایِ صف‌شده» همان‌جا پیام‌هایِ گیرکرده را دوباره نوبت می‌دهد.
# کاوه‌نگار: برایِ حساب‌هایِ سازمانی، «send lookup» به endpoint سرویس‌دار می‌رود
# SMS_KAVENEGAR_SERVICE=1

# --- پشتیبان‌گیری ------------------------------------------------------
# شاخه‌ای که فایل‌هایِ پشتیبان در آن نوشته می‌شود
BACKUP_DIR=/var/backups/setshop
# نگه‌داری: ۳۰ نسخه‌ی روزانه، ۱۲ نسخه‌ی ماهانه
BACKUP_RETAIN_DAYS=30
BACKUP_RETAIN_MONTHS=12
# کپیِ دوم روی یک دیسک/ماشینِ دیگر (اختیاری؛ اگر پر باشد، با rsync کپی می‌شود)
BACKUP_MIRROR_DIR=
